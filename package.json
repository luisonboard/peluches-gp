{
  "name": "peluches-gp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:copa": "esbuild scripts/check-cup.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/check-cup.cjs && node node_modules/.cache/check-cup.cjs",
    "preview": "vite preview",
    "dev:lan": "vite --mode lan",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev --port 8787"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "qrcode-generator": "^1.4.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "wrangler": "^4.42.0",
    "ws": "^8.18.0"
  }
}
